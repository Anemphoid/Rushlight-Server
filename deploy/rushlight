#!/usr/bin/env bash
# rushlight: set up and run a Rushlight server with Docker Compose (Linux).
#
#   ./rushlight setup      first time: make the secrets and settings, then start
#   ./rushlight start | stop | restart | status | logs [server|livekit]
#   ./rushlight check      look for problems and say what to do about each
#
# Everything lives in the folder this file is in: compose.yaml, .env (the secrets: keep it private), livekit.yaml.
# The server's data is in a Docker volume called rushlight_data.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$HERE"

DEFAULT_LIVEKIT_VERSION="v1.13.11"
SERVER_PORT_DEFAULT=4000

say()  { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }
die()  { warn "Problem: $*"; exit 1; }

compose() { docker compose --project-directory "$HERE" -f "$HERE/compose.yaml" "$@"; }

need_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed. Install it from https://docs.docker.com/engine/install/ and run this again."
  docker compose version >/dev/null 2>&1 || die "Docker is here but 'docker compose' is not. Install the Docker Compose plugin (https://docs.docker.com/compose/install/linux/)."
  docker info >/dev/null 2>&1 || die "Docker is installed but not running, or you are not allowed to use it. Try 'sudo systemctl start docker', and add yourself to the docker group ('sudo usermod -aG docker \$USER', then log out and in)."
}

random_hex() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }

lan_ip() {
  local ip=""
  if command -v ip >/dev/null 2>&1; then
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n1)"
  fi
  [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1 || true)"
  printf '%s' "$ip"
}

env_get() { [ -f .env ] && sed -n "s/^$1=//p" .env | head -n1 || true; }

# The server runs as an ordinary user inside its container and has to read .env for the backups. When that user is not the
# file's owner, widen the file itself and rely on this folder being closed to other accounts.
fix_env_perms() {
  chmod 700 "$HERE"
  chmod 600 .env
  [ "$(id -u)" = 1000 ] || chmod 644 .env
}
env_set() { # KEY VALUE (values here never contain slashes or ampersands that matter: versions, addresses)
  local v="${2//\\/\\\\}"; v="${v//&/\\&}"; v="${v//|/\\|}"
  if grep -q "^$1=" .env; then sed -i "s|^$1=.*|$1=$v|" .env; else printf '%s=%s\n' "$1" "$2" >> .env; fi
}
# (a RUSHLIGHT_IMAGE / RUSHLIGHT_VERSION in the environment wins over .env, as it does for Compose; a restore on a new computer has no .env yet)
image_name() { local i="${RUSHLIGHT_IMAGE:-$(env_get RUSHLIGHT_IMAGE)}"; printf '%s' "${i:-ghcr.io/anemphoid/rushlight-server}"; }
image_version() { local v="${RUSHLIGHT_VERSION:-$(env_get RUSHLIGHT_VERSION)}"; printf '%s' "${v:-stable}"; }

# The data volume is made by Compose (project "rushlight", volume "data"). These helpers make sure it exists with Compose's labels
# even on a computer that has not started the stack yet (a restore), and run one command against it with no network.
VOLUME=rushlight_data
ensure_volume() {
  docker volume inspect "$VOLUME" >/dev/null 2>&1 || docker volume create --label com.docker.compose.project=rushlight --label com.docker.compose.volume=data "$VOLUME" >/dev/null
}
volrun() { # IMAGE command... (as the server's own user)
  local image="$1"; shift
  ensure_volume
  docker run --rm --network none -v "$VOLUME:/data" --entrypoint "$1" "$image" "${@:2}"
}

valid_ip() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }

cmd_setup() {
  local ip="" port="$SERVER_PORT_DEFAULT" yes=0 start=1 version="" lkversion="$DEFAULT_LIVEKIT_VERSION" image=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ip) ip="${2:-}"; shift 2 ;;
      --port) port="${2:-}"; shift 2 ;;
      --yes) yes=1; shift ;;
      --no-start) start=0; shift ;;
      --version) version="${2:-}"; shift 2 ;;
      --image) image="${2:-}"; shift 2 ;;
      --livekit-version) lkversion="${2:-}"; shift 2 ;;
      private) shift ;;
      *) die "I do not know '$1'. Try ./rushlight help." ;;
    esac
  done
  need_docker
  if [ -f .env ]; then
    die "This folder is already set up (.env exists). Use './rushlight start', or './rushlight check' to see how it is doing. Setting up again would replace the secrets and sign everyone out, so I will not do it."
  fi
  [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "The port '$port' is not a number from 1 to 65535."
  [ -n "$ip" ] || ip="$(lan_ip)"
  if [ -z "$ip" ]; then
    die "I could not work out this computer's network address. Run again with --ip followed by it, for example: ./rushlight setup --ip 192.168.1.20"
  fi
  valid_ip "$ip" || die "'$ip' does not look like an address such as 192.168.1.20."

  say "Setting up a Private Rushlight server."
  say "  Address people will use: http://$ip:$port  (only people on your network, or connected to it, can reach it)"
  if [ "$yes" -ne 1 ]; then
    printf 'Go ahead? [Y/n] '; read -r answer || answer=n
    case "${answer:-Y}" in [Nn]*) say "Nothing was changed."; exit 0 ;; esac
  fi

  umask 077
  local tmp; tmp="$(mktemp .env.XXXXXX)"
  {
    echo "# Written by ./rushlight setup. These are your server's secrets: keep this file private and never share it."
    echo "# It is included in the server's encrypted backups, so a restored server keeps them."
    echo "RUSHLIGHT_MODE=private"
    [ -z "$image" ] || echo "RUSHLIGHT_IMAGE=$image"
    echo "RUSHLIGHT_VERSION=${version:-stable}"
    echo "LIVEKIT_VERSION=$lkversion"
    echo "HOST_IP=$ip"
    echo "PORT=$port"
    echo "JWT_SECRET=$(random_hex 48)"
    echo "LIVEKIT_URL=ws://127.0.0.1:7880"
    echo "LIVEKIT_API_KEY=API$(random_hex 8)"
    echo "LIVEKIT_API_SECRET=$(random_hex 32)"
  } > "$tmp"
  mv "$tmp" .env
  fix_env_perms
  write_livekit_config
  say "Secrets and settings written (not shown here; they are in .env)."
  if [ "$start" -eq 1 ]; then cmd_start; fi
}

write_livekit_config() {
  local ip key secret
  ip="$(env_get HOST_IP)"; key="$(env_get LIVEKIT_API_KEY)"; secret="$(env_get LIVEKIT_API_SECRET)"
  [ -n "$ip" ] && [ -n "$key" ] && [ -n "$secret" ] || die ".env is missing HOST_IP or the LiveKit key. Restore it from a backup, or move this folder aside and set up again."
  local tmp; tmp="$(mktemp livekit.yaml.XXXXXX)"
  cat > "$tmp" <<YAML
# Written by ./rushlight (do not edit; it is made again from .env).
port: 7880
rtc:
  tcp_port: 7881
  # One UDP port for all voice, so one port to open and nothing else.
  udp_port: 7882
  use_external_ip: false
  node_ip: $ip
keys:
  $key: $secret
YAML
  chmod 644 "$tmp"; mv "$tmp" livekit.yaml
}

cmd_start() {
  need_docker
  [ -f .env ] || die "Not set up yet. Run './rushlight setup' first."
  [ -f livekit.yaml ] || write_livekit_config
  # No pull here on purpose: only ./rushlight update changes versions, so a restart can never move you onto a new one.
  compose up -d
  say "Waiting for the server to answer..."
  if wait_healthy 90; then
    say "Rushlight is running at http://$(env_get HOST_IP):$(env_get PORT)"
  else
    warn "The server did not answer within 90 seconds. Run './rushlight check' and './rushlight logs server'."
    return 1
  fi
}

wait_healthy() {
  local port; port="$(env_get PORT)"; port="${port:-$SERVER_PORT_DEFAULT}"
  local i
  for ((i = 0; i < $1; i++)); do
    if curl -fsS -m 3 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  return 1
}

cmd_stop()    { need_docker; compose stop; }
cmd_restart() { need_docker; compose restart; }
cmd_logs()    { need_docker; compose logs --tail 200 -f "$@"; }

cmd_status() {
  need_docker
  compose ps
  local port; port="$(env_get PORT)"; port="${port:-$SERVER_PORT_DEFAULT}"
  if curl -fsS -m 3 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then say "The server answers."; else say "The server does not answer."; fi
}

# check: every line starts with ok / PROBLEM / note, and PROBLEM lines say what to do. Exit status 1 when any PROBLEM.
cmd_check() {
  local bad=0
  ok()   { say "ok       $*"; }
  prob() { say "PROBLEM  $*"; bad=1; }
  note() { say "note     $*"; }

  if ! command -v docker >/dev/null 2>&1; then prob "Docker is not installed. Install it: https://docs.docker.com/engine/install/"; exit 1; fi
  ok "Docker is installed"
  docker compose version >/dev/null 2>&1 && ok "Docker Compose is installed" || prob "Docker Compose is missing. Install the Compose plugin: https://docs.docker.com/compose/install/linux/"
  docker info >/dev/null 2>&1 && ok "Docker is running and you may use it" || { prob "Docker is not running, or you are not allowed to use it ('sudo systemctl start docker'; 'sudo usermod -aG docker \$USER' then log out and in)"; exit 1; }

  if [ -f .env ]; then ok "Settings file (.env) is there"; else prob "No .env. Run ./rushlight setup"; exit 1; fi
  local key
  for key in JWT_SECRET LIVEKIT_API_KEY LIVEKIT_API_SECRET LIVEKIT_URL HOST_IP PORT LIVEKIT_VERSION; do
    [ -n "$(env_get "$key")" ] || prob ".env has no $key. Restore .env from your backup."
  done
  [ -f livekit.yaml ] && ok "LiveKit settings (livekit.yaml) are there" || prob "livekit.yaml is missing. './rushlight start' makes it again."

  local port ip
  port="$(env_get PORT)"; ip="$(env_get HOST_IP)"
  local running; running="$(compose ps --status running --services 2>/dev/null | tr '\n' ' ')"
  case "$running" in *server*) ok "The server container is running" ;; *) prob "The server container is not running. './rushlight start', then './rushlight logs server' if it stops again." ;; esac
  case "$running" in *livekit*) ok "The voice container (LiveKit) is running" ;; *) prob "The voice container is not running. './rushlight start', then './rushlight logs livekit'." ;; esac

  if curl -fsS -m 3 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then ok "The server answers on port $port"; else prob "The server does not answer on port $port"; fi
  if curl -fsS -m 3 "http://127.0.0.1:7880" >/dev/null 2>&1; then ok "LiveKit answers on port 7880"; else prob "LiveKit does not answer on port 7880"; fi

  local now; now="$(lan_ip)"
  if [ -z "$now" ]; then
    note "I could not work out this computer's current network address."
  elif [ "$now" != "$ip" ]; then
    prob "This computer's address is now $now but Rushlight was set up for $ip, so voice will fail for other people. Run: ./rushlight address $now"
  else
    ok "This computer's address ($ip) is the one Rushlight was set up for"
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi "Status: active"; then
    note "ufw (a firewall) is on. Allow people in: sudo ufw allow $port/tcp; sudo ufw allow 7880/tcp; sudo ufw allow 7881/tcp; sudo ufw allow 7882/udp"
  fi
  local mode; mode="$(env_get RUSHLIGHT_MODE)"
  [ "$mode" = private ] && note "Private mode: only people on your network, or connected to it, can join."
  exit "$bad"
}

# update [--version vX.Y.Z]: a safe update. Downloads first (nothing changes if that fails), makes an encrypted backup if they are
# set up, keeps a plain copy of the database as the way back, switches, waits for the server to answer, and if it does not, puts the
# old version and the old data back.
cmd_update() {
  local version="" 
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) version="${2:-}"; shift 2 ;;
      *) die "I do not know '$1'. Try ./rushlight help." ;;
    esac
  done
  need_docker
  [ -f .env ] || die "Not set up yet. Run './rushlight setup' first."
  local img cur target old_id new_id
  img="$(image_name)"; cur="$(image_version)"; target="${version:-$cur}"
  old_id="$(docker image inspect -f '{{.Id}}' "$img:$cur" 2>/dev/null || true)"
  [ -n "$old_id" ] || old_id="$(docker inspect -f '{{.Image}}' "$(compose ps -q server 2>/dev/null | head -n1)" 2>/dev/null || true)"

  say "Downloading $img:$target ..."
  docker pull "$img:$target" >/dev/null 2>&1 || docker image inspect "$img:$target" >/dev/null 2>&1 || die "I could not download $img:$target (no internet, or no such version). Nothing was changed."
  new_id="$(docker image inspect -f '{{.Id}}' "$img:$target")"
  if [ "$new_id" = "$old_id" ] && [ "$target" = "$cur" ]; then say "Already up to date ($cur)."; return 0; fi

  if compose exec -T server test -f /data/backup-public.key >/dev/null 2>&1; then
    say "Making an encrypted backup first ..."
    compose exec -T server node src/backup-cli.js now || die "The backup failed, so I did not update. Fix that ('./rushlight backup list') or ask for help."
  else
    note_line "Encrypted backups are not set up (./rushlight backup setup). A plain safety copy is made anyway, and removed when the update works."
  fi

  local helper="${old_id:-$img:$target}"
  say "Stopping the server and keeping a copy of the data ..."
  compose stop server >/dev/null
  volrun "$helper" sh -c 'rm -rf /data/rollback && mkdir /data/rollback && cp -p /data/rushlight.db* /data/rollback/' || { compose up -d server >/dev/null 2>&1 || true; die "I could not make the safety copy, so nothing was changed."; }

  env_set RUSHLIGHT_VERSION "$target"
  say "Starting $target ..."
  compose up -d server >/dev/null
  if wait_healthy "${RUSHLIGHT_UPDATE_WAIT:-90}"; then
    volrun "$helper" rm -rf /data/rollback >/dev/null 2>&1 || true
    say "Updated to $target. Rushlight is running at http://$(env_get HOST_IP):$(env_get PORT)"
    return 0
  fi

  warn "The new version did not start properly. Putting the old version and your data back ..."
  compose stop server >/dev/null 2>&1 || true
  volrun "$helper" sh -c 'rm -f /data/rushlight.db* && cp -p /data/rollback/rushlight.db* /data/' || die "I could not put the data back. It is safe in the volume $VOLUME, in /data/rollback. Ask for help before doing anything else."
  env_set RUSHLIGHT_VERSION "$cur"
  if [ -n "$old_id" ]; then docker tag "$old_id" "$img:$cur"; fi
  compose up -d server >/dev/null
  if wait_healthy 60; then
    volrun "$helper" rm -rf /data/rollback >/dev/null 2>&1 || true
    warn "Rolled back: Rushlight is running the old version ($cur) again, with your data as it was. Nothing was lost."
    warn "See what went wrong with: ./rushlight logs server"
  else
    warn "The old version did not start either. Your data is safe (encrypted backups, and the copy in /data/rollback). Run ./rushlight check and ./rushlight logs server."
  fi
  return 1
}
note_line() { say "note     $*"; }

# backup ...: the server's own backup tool (see docs/backups.md), run inside the container. Plus `backup export` to copy the newest
# backup file out of the container, onto this computer's disk, so it can be put somewhere else.
cmd_backup() {
  need_docker
  case "${1:-}" in
    export)
      local name dest="${2:-.}"
      name="$(compose exec -T server sh -c 'ls -1 /data/backups 2>/dev/null' | tr -d '\r' | grep '\.rlbak$' | sort | tail -n1 || true)"
      [ -n "$name" ] || die "There are no backups yet. Make one with: ./rushlight backup now"
      compose cp "server:/data/backups/$name" "$dest/$name"
      say "Copied $name to $dest. It is encrypted: keep it somewhere that is not on this computer."
      ;;
    "") die "Try: ./rushlight backup setup | now | list | check FILE | export [FOLDER]" ;;
    *)
      # a terminal for the questions (setup, check, restore) only when there is one; scripts and cron have none
      local tty=(); [ -t 0 ] || tty=(-T)
      compose exec "${tty[@]}" server node src/backup-cli.js "$@" ;;
  esac
}

# restore FILE.rlbak: put a backup back (asks for the 12 words). Works on a computer that has never run Rushlight: the backup carries
# the .env, so the secrets (and everyone's sign-ins) come back with it. The data it replaces is kept in the volume in /data/before-restore.
cmd_restore() {
  local file="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  [ -n "$file" ] || die "Give the backup file: ./rushlight restore /path/to/rushlight-2026-01-01.rlbak"
  [ -f "$file" ] || die "I cannot find $file."
  need_docker
  file="$(readlink -f "$file")"
  local img ver; img="$(image_name)"; ver="$(image_version)"
  docker image inspect "$img:$ver" >/dev/null 2>&1 || docker pull "$img:$ver" >/dev/null || die "I could not download $img:$ver."
  if [ -f .env ] && [ "$yes" -ne 1 ]; then
    say "This REPLACES the server's data and settings with what is in the backup. What is here now is kept (data: inside the Docker volume, in /data/before-restore; settings: .env.before-restore)."
    printf 'Go ahead? [y/N] '; read -r answer || answer=n
    case "${answer:-N}" in [Yy]*) ;; *) say "Nothing was changed."; exit 0 ;; esac
  fi
  local had_env=0 keep_img="" keep_ver="" keep_lk=""
  if [ -f .env ]; then had_env=1; keep_img="$(env_get RUSHLIGHT_IMAGE)"; keep_ver="$(env_get RUSHLIGHT_VERSION)"; keep_lk="$(env_get LIVEKIT_VERSION)"; compose stop server >/dev/null 2>&1 || true; fi
  volrun "$img:$ver" sh -c 'rm -rf /data/restore-tmp /data/before-restore; if [ -f /data/rushlight.db ]; then mkdir /data/before-restore && cp -p /data/rushlight.db* /data/before-restore/; fi'
  # The file goes into the volume first (read through a plain redirect: its owner on this computer need not be the container's user).
  ensure_volume
  docker run --rm -i --network none -v "$VOLUME:/data" --entrypoint sh "$img:$ver" -c 'cat > /data/restore-in.rlbak' < "$file" \
    || { [ "$had_env" -eq 0 ] || compose up -d server >/dev/null 2>&1 || true; die "I could not read $file. Nothing was changed."; }
  local tty=(-i); [ -t 0 ] && tty=(-it)
  docker run --rm "${tty[@]}" --network none -v "$VOLUME:/data" --entrypoint node "$img:$ver" src/backup-cli.js restore /data/restore-in.rlbak /data/restore-tmp \
    || { volrun "$img:$ver" rm -rf /data/restore-tmp /data/restore-in.rlbak >/dev/null 2>&1 || true; [ "$had_env" -eq 0 ] || compose up -d server >/dev/null 2>&1 || true; die "The backup was not restored (wrong words, or a damaged file). Nothing was changed."; }
  (umask 077; volrun "$img:$ver" cat /data/restore-tmp/restored.env > .env.restored)
  [ -s .env.restored ] || { rm -f .env.restored; [ "$had_env" -eq 0 ] || compose up -d server >/dev/null 2>&1 || true; die "That backup holds no settings file. Nothing was changed."; }
  volrun "$img:$ver" sh -c 'rm -f /data/rushlight.db* && mv /data/restore-tmp/rushlight.db /data/rushlight.db && rm -rf /data/restore-tmp /data/restore-in.rlbak'
  [ ! -f .env ] || mv .env .env.before-restore
  mv .env.restored .env
  fix_env_perms
  # keep the versions this computer was running (the backup may be from an older one); a new computer takes the backup's
  if [ "$had_env" -eq 1 ]; then
    [ -z "$keep_img" ] || env_set RUSHLIGHT_IMAGE "$keep_img"
    [ -z "$keep_ver" ] || env_set RUSHLIGHT_VERSION "$keep_ver"
    [ -z "$keep_lk" ] || env_set LIVEKIT_VERSION "$keep_lk"
  fi
  local ip; ip="$(lan_ip)"; [ -z "$ip" ] || env_set HOST_IP "$ip"
  write_livekit_config
  say "Restored. Starting ..."
  cmd_start
}

# address: the computer moved to a new address on the network.
cmd_address() {
  need_docker
  local ip="${1:-}"; [ -n "$ip" ] || ip="$(lan_ip)"
  valid_ip "$ip" || die "Give the new address, for example: ./rushlight address 192.168.1.20"
  [ -f .env ] || die "Not set up yet."
  sed -i "s/^HOST_IP=.*/HOST_IP=$ip/" .env
  write_livekit_config
  compose up -d --force-recreate livekit
  say "Done. People now connect to http://$ip:$(env_get PORT) (change the address in their app: Settings > Connection)."
}

cmd_help() {
  cat <<'TXT'
rushlight setup            make the secrets and settings, then start (first time only)
  --ip ADDRESS               use this network address instead of the one found
  --port N                   the server's port (default 4000)
  --yes                      do not ask
rushlight start | stop | restart
rushlight status
rushlight logs [server|livekit]
rushlight check            look for problems, and say what to do about each
rushlight address [ADDRESS]  this computer's network address changed
rushlight update [--version vX.Y.Z]   update safely (backup, copy of the data, and a way back if it does not start)
rushlight backup setup|now|list|check FILE|export [FOLDER]   encrypted backups
rushlight restore FILE.rlbak   put a backup back (also onto a new computer)
TXT
}

case "${1:-help}" in
  setup)   shift; cmd_setup "$@" ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    shift; cmd_logs "$@" ;;
  check)   cmd_check ;;
  address) shift; cmd_address "$@" ;;
  update)  shift; cmd_update "$@" ;;
  backup)  shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "I do not know '$1'. Try ./rushlight help." ;;
esac
