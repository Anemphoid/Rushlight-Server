# Copy this file to .env and fill in real values before starting the server.
# .env is ignored by git; it stays on this machine and survives every update.

# A long random string, used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=4000

# Where the SQLite database file is written. Defaults to rushlight.db next to
# the server code if left unset. Also ignored by git.
# DB_PATH=/var/lib/rushlight/rushlight.db

# Your LiveKit server. LIVEKIT_URL is the address clients connect to (ws:// or
# wss://), so it must be reachable from every client. The key and secret are the
# pair from your LiveKit config (livekit.yaml).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Only set this if Rushlight is genuinely running behind a reverse proxy
# (e.g. Caddy). It changes how rate limiting identifies a client, and setting it
# with no real proxy in front lets that limit be bypassed entirely.
# TRUST_PROXY=1

# Rate limits, per client address (all optional; these are the defaults).
# LOGIN_LIMIT=10          login attempts per 15 minutes
# REGISTER_LIMIT=10       new accounts per hour
# JOIN_LIMIT=20           join-code attempts per 15 minutes
# PRESENCE_LIMIT=600      presence check-ins per minute
# RECOVER_LIMIT=5         password resets with a recovery key per 15 minutes
# ACCOUNT_LIMIT=10        password changes and new recovery keys per 15 minutes

# Timing for ephemeral chats (all optional; the defaults suit real use).
# PRESENCE_TTL_MS=20000
# WIPE_GRACE_MS=10000
# PRESENCE_SWEEP_MS=1000
