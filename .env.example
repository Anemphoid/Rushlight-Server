# Copy this file to .env and fill in real values before starting the server.

# A long random string — used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=4000

# Where the SQLite database file is written. Defaults to rushlight.db next
# to this file if left unset.
# DB_PATH=/opt/rushlight/rushlight.db

# LiveKit connection details for the unison instance on Catacombs.
# LIVEKIT_URL is the same wss:// address the Electron client already uses.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Only set this if Rushlight is genuinely running behind a reverse proxy
# (e.g. Caddy). It changes how login/register rate limiting identifies a
# client — wrongly setting it with no real proxy in front lets that limit
# be bypassed entirely.
# TRUST_PROXY=1
